<%= form_with(model: appointment) do |f| %>
  <%= render 'shared/error_messages', object: appointment if lookup_context.exists?('shared/error_messages', [], true) %>

  <div class="mb-3">
    <%= f.label :pet_id, "Pet", class: "form-label" %>
    <%= f.collection_select :pet_id, policy_scope(Pet), :id, :name, { prompt: "Select Pet" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :vet_id, "Veterinarian", class: "form-label" %>
    <%= f.collection_select :vet_id, policy_scope(Vet), :id, :last_name, { prompt: "Select Vet" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status, Appointment.statuses.keys.map { |s| [s.humanize, s] }, {}, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :date, "Appointment Date", class: "form-label" %>
    <%= f.datetime_field :date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :reason, class: "form-label" %>
    <%= f.text_area :reason, class: "form-control", rows: 3 %>
  </div>

  <%= f.submit "Save Appointment", class: "btn btn-primary" %>
<% end %>