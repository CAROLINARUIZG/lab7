<div class="d-flex justify-content-between align-items-center my-4">
  <h1>Citas Médicas</h1>
  <% if policy(Appointment).new? %>
    <%= link_to 'Nueva Cita', new_appointment_path, class: 'btn btn-primary shadow-sm' %>
  <% end %>
</div>

<table class="table table-striped table-hover border shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>Fecha</th>
      <th>Mascota</th>
      <th>Veterinario</th>
      <th>Motivo</th>
      <th>Estado</th>
    </tr>
  </thead>

  <tbody>
    <% if @appointments.any? %>
      <% @appointments.each do |app| %>
        <tr>
          <td><%= link_to app.date&.strftime("%B %d, %Y") || "Sin fecha", appointment_path(app) %></td>
          <td><%= app.pet&.name %></td>
          <td>Dr. <%= app.vet&.last_name %></td>
          <td><%= app.reason %></td>
          <td>
            <span class="badge <%= app.status.to_s == 'completed' ? 'bg-success' : 'bg-primary' %>">
              <%= app.status.to_s.titleize %>
            </span>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="5" class="text-center text-muted">No appointments found.</td>
      </tr>
    <% end %>
  </tbody>
</table>