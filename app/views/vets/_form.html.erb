<%= form_with(model: vet) do |f| %>
  <% if vet.errors.any? %>
    <div class="alert alert-danger shadow-sm">
      <h6 class="alert-heading fw-bold">ERROR</h6>
      <ul class="mb-0">
        <% vet.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :first_name, "Nombre", class: "form-label fw-bold" %>
    <%= f.text_field :first_name, class: "form-control", placeholder: "Ej. Juan" %>
  </div>

  <div class="mb-3">
    <%= f.label :last_name, "Apellido", class: "form-label fw-bold" %>
    <%= f.text_field :last_name, class: "form-control", placeholder: "Ej. Pérez" %>
  </div>

  <div class="mb-3">
    <%= f.label :email, "Correo Electrónico", class: "form-label fw-bold" %>
    <%= f.email_field :email, class: "form-control", placeholder: "juan.perez@vetclinic.com" %>
  </div>

  <div class="mb-3">
    <%= f.label :specialization, "Especialidad", class: "form-label fw-bold" %>
    <%= f.text_field :specialization, class: "form-control", placeholder: "Ej. Cirugía, Medicina Felina..." %>
  </div>

  <div class="d-grid gap-2 pt-2">
    <%= f.submit "Guardar Veterinario", class: "btn btn-success btn-lg shadow-sm" %>
  </div>
<% end %>