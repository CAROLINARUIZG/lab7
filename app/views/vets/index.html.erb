<div class="d-flex justify-content-between align-items-center my-4">
  <h1>Personal Veterinario</h1>
  <% if policy(Vet).new? %>
    <%= link_to 'Nuevo Veterinario', new_vet_path, class: 'btn btn-success shadow-sm' %>
  <% end %>
</div>

<div class="table-responsive shadow-sm rounded">
  <table class="table table-hover align-middle bg-white mb-0">
    <thead class="table-dark">
      <tr>
        <th>Nombre Completo</th>
        <th>Especialidad</th>
        <th>Email</th>
        <th class="text-center">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if @vets.any? %>
        <% @vets.each do |vet| %>
          <tr>
            <td class="fw-bold"><%= "#{vet.first_name} #{vet.last_name}" %></td>
            <td><span class="badge bg-light text-dark border"><%= vet.specialization %></span></td>
            <td><%= vet.email %></td>
            <td class="text-center">
              <div class="btn-group">
                <% if policy(vet).edit? %>
                  <%= link_to 'Editar', edit_vet_path(vet), class: "btn btn-sm btn-outline-warning" %>
                <% end %>
                <% if policy(vet).destroy? %>
                  <%= link_to 'Eliminar', vet, data: { turbo_method: :delete, turbo_confirm: '¿Estás seguro?' }, class: "btn btn-sm btn-outline-danger" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="4" class="text-center py-4 text-muted">No hay veterinarios registrados.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>