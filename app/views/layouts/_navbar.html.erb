<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <%= link_to 'VetClinic', root_path, class: 'navbar-brand' %>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <%# Enlace dinámico según rol para Owners %>
          <% if current_user.admin? || current_user.vet? %>
            <%= link_to 'Owners', owners_path, class: 'nav-link' %>
          <% elsif current_user.owner? && current_user.owner.present? %>
            <%= link_to 'My Profile', owner_path(current_user.owner), class: 'nav-link' %>
          <% end %>

          <%= link_to 'Pets', pets_path, class: 'nav-link' %>
          <%= link_to 'Veterinaries', vets_path, class: 'nav-link' %>
          
          <%# REEMPLAZO: Cambiamos Treatments por Appointments %>
          <%= link_to 'Appointments', appointments_path, class: 'nav-link' %>
        <% end %>
      </div>

      <div class="navbar-nav">
        <% if user_signed_in? %>
          <span class="nav-link text-light me-2">
            <small class="badge bg-secondary me-1"><%= current_user.role.upcase %></small>
            <%= "#{current_user.first_name} #{current_user.last_name}" %>
          </span>
          
          <%= button_to "Sign out", destroy_user_session_path, 
                        method: :delete, 
                        class: "btn btn-outline-light btn-sm" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "nav-link" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>