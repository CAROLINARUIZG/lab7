<div class="d-flex justify-content-between align-items-center my-4">
  <h1>Pets</h1>
  <% if policy(Pet).new? %>
    <%= link_to 'New Pet', new_pet_path, class: 'btn btn-primary shadow-sm' %>
  <% end %>
</div>

<table class="table table-striped table-hover border shadow-sm align-middle">
  <thead class="table-dark">
    <tr>
      <th>Photo</th>
      <th>Name</th>
      <th>Species</th>
      <th>Breed</th>
      <th>Owner</th>
      <th>Birth Date</th>
      <th class="text-center">Actions</th> <%# Nueva columna para acciones %>
    </tr>
  </thead>
  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td>
          <% if pet.photo.attached? %>
            <%= image_tag pet.photo.variant(resize_to_fill: [60, 60]), class: "rounded shadow-sm border" %>
          <% else %>
            <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
              <span class="text-muted" style="font-size: 0.7rem;">No photo</span>
            </div>
          <% end %>
        </td>
        
        <td><%= link_to pet.name, pet_path(pet), class: "fw-bold text-decoration-none" %></td>
        <td><%= pet.species %></td>
        <td><%= pet.breed %></td>
        <td><%= pet.owner.first_name %> <%= pet.owner.last_name %></td>
        <td><%= pet.birth_date.strftime("%B %d, %Y") %></td>

        <td class="text-center">
          <div class="btn-group" role="group">
            <% if policy(pet).edit? %>
              <%= link_to 'Edit', edit_pet_path(pet), class: "btn btn-outline-warning btn-sm" %>
            <% end %>

            <% if policy(pet).destroy? %>
              <%= link_to 'Delete', pet, 
                          data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, 
                          class: "btn btn-outline-danger btn-sm" %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>